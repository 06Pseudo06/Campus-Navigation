# CampusWay Backend Environment Configuration
# Copy this file to .env and supply your credentials

# Google OAuth 2.0 Credentials (obtain from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend URL for redirection and CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Cryptographic Session & State Secret (minimum 32 random characters)
SESSION_SECRET=campusway-dev-secret-key-must-be-changed-in-production-min-32-chars

# Runtime Environment (development | production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
