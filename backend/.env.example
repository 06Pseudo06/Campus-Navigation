# FastAPI Application Settings
PROJECT_NAME="CampusWay Route Intelligence Service"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]

# Database Connection (PostgreSQL)
# Option 1: Native Local PostgreSQL (Default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusway_db

# Option 2: Shared / Cloud-Hosted PostgreSQL (e.g., Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql://<user>:<password>@<db-host>:5432/<dbname>?sslmode=require

# Note: In Docker Compose, DATABASE_URL is automatically injected using the internal
# container service name (postgresql://postgres:postgres_password@postgres:5432/campusway_db).
