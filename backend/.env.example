# Copy this file to backend/.env and replace placeholders with your own values.
# Never commit backend/.env or share live credentials in Git.

PROJECT_NAME=CampusWay Route Intelligence Service
API_V1_STR=/api/v1
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Replace with your team's PostgreSQL URL. Keep the actual URL in backend/.env only.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate private random secrets for local development.
ADMIN_API_KEY=replace-with-a-local-admin-key
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional provider credentials; configure only if the corresponding login flow is used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
