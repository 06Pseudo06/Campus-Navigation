# ==========================================
# CampusWay Environment Configuration Template
# (Variable Names Only — No Real Values)
# ==========================================

# Database Configuration (Neon Serverless PostgreSQL or Local Docker)
DATABASE_URL=postgresql://username:password@localhost:5432/campus_nav_db

# Security & Session Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
ADMIN_API_KEY=replace_with_a_secure_admin_api_token
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_DEFAULT_MAX_AGE_SECONDS=86400

# Backend Core Configuration
PROJECT_NAME=CampusWay
API_V1_STR=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL & API Gateway
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CampusWay

# Google OAuth 2.0 Credentials (Optional in local dev)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# SMS Gateway (Optional: defaults to dev console logging when unconfigured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Transactional Email (Optional: defaults to dev console logging when unconfigured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

