# =============================================================================
# CampusWay Docker Compose Environment Configuration Template
# Copy this file to .env in the project root for custom Docker Compose settings.
# Do NOT commit actual secrets or credentials to source control.
# =============================================================================

# --- Backend Database Connection (Default: Remote Neon PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Service Port Bindings ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Security and Authentication ---
PROJECT_NAME=CampusWay Route Intelligence Service
ADMIN_API_KEY=replace-with-a-secure-admin-key
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=production

# --- Frontend & Cross-Origin Configuration ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token
BACKEND_INTERNAL_URL=http://backend:8000

# --- Local PostgreSQL Settings (Only used with: docker-compose --profile local-db up) ---
POSTGRES_PORT=5432
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres_password
LOCAL_DB_NAME=campusway_db
